# Copy to .env, which git ignores, and fill it in. These values are what the
# setup portal's form starts with; the board keeps what you save there. They
# are baked in at build time, so do not share a .bin built with your .env.
WIFI_SSID=
WIFI_PASSWORD=
BTC_ADDRESS=
# Appended to the address after a dot, as the pool user name.
WORKER=

# Optional, these are the C++ firmware's defaults.
POOL_HOST=public-pool.io
POOL_PORT=3333
POOL_PASSWORD=x
# Hours from UTC for the clock.
TIMEZONE=2
